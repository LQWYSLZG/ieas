# Base URL for the backend API_Server.
# In local dev this is left unset so the app defaults to "/api/v1", which the
# Vite dev server proxies to the local backend at http://localhost:8000.
# In the split production deploy (frontend on GitHub Pages, backend on Render),
# set this to the full Render origin plus the /api/v1 prefix, for example:
#   VITE_API_BASE_URL=https://your-render-service.onrender.com/api/v1
# This value is not a secret. Do not put secrets in this file.
VITE_API_BASE_URL=
